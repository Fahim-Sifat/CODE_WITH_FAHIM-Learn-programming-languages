# --- CACHING RULES ---

# Rule for HTML files (*.html): 
# Forces browsers to re-validate on every visit, ensuring new deployments show up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Rule for Assets (CSS, JS, Images, Fonts): 
# Caches them for one year for excellent performance, assuming their filenames change when content changes.
/*.(css|js|woff|woff2|jpg|png|svg|gif|ico)
  Cache-Control: public, max-age=31536000, immutable


# --- SECURITY RULES (Highly Recommended) ---

# Apply these security headers to all files
/*
  # Prevents your site from being embedded in an iframe (Clickjacking protection)
  X-Frame-Options: DENY

  # Prevents the browser from guessing file types, mitigating some security issues
  X-Content-Type-Options: nosniff

  # Controls what referrer information is sent when linking away from your site
  Referrer-Policy: no-referrer-when-downgrade

  # Enforces HTTPS for future visits (ONLY use if your site is permanently on HTTPS, which Cloudflare is)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload